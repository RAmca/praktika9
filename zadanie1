#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <locale.h>

int main() {
    setlocale(LC_ALL, "Russian");

    printf("\n--- Вариант 12 ---\n");
    for (int i = 0; i < 5; i++) {
        int start_num = 30 - i;
        
        for (int j = start_num; j <= 30; j++) {
            printf("%4d", j);
        }
        printf("\n");
    }
    return 0;
}
