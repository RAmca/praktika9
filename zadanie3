#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <locale.h>

int main() {
    setlocale(LC_ALL, "Russian");

    char symbol;
    int a, h;
    char answer;

    do {
        printf("\nВведите символ для рисования: ");
        scanf(" %c", &symbol);

        printf("Введите верхнее основание a: ");
        scanf("%d", &a);

        printf("Введите высоту h: ");
        scanf("%d", &h);

        if (a < 1 || h < 1) {
            printf("Размеры должны быть больше 0!\n");
            continue;
        }

        int b = a + 2 * (h - 1);

        printf("\nВаша фигура:\n\n");

        for (int i = 0; i < h; i++) {
            //Отступ слева
            for (int j = 0; j < (h - 1 - i); j++) {
                printf(" ");
            }

            //Верхняя и нижняя линии
            if (i == 0) {
                for (int j = 0; j < a; j++) printf("%c", symbol);
            } 
            else if (i == h - 1) {
                for (int j = 0; j < b; j++) printf("%c", symbol);
            } 
            //Боковые стенки
            else {
                printf("%c", symbol);

                int inner_spaces = a + 2 * i - 2;
                for (int j = 0; j < inner_spaces; j++) {
                    printf(" ");
                }
                printf("%c", symbol);
            }
            printf("\n");
        }

        while (getchar() != '\n');

        printf("\nПродолжить? (Да - введите любое число, Нет - введите 0): ");
        int choice;
        scanf("%d", &choice);
        if (choice == 0) break;

    } while (1);

    return 0;
}
